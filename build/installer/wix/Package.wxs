<?xml version="1.0" encoding="utf-8"?>
<?ifndef PublishDir ?>
  <?error PublishDir belum diberikan. Jalankan scripts\build-msi.ps1 yang meneruskan folder publish hasil build-installer.ps1 ?>
<?endif ?>
<?ifndef ProductVersion ?>
  <?define ProductVersion = "1.2.13" ?>
<?endif ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Seruni 22 Bakery"
           Manufacturer="Seruni 22"
           Version="$(var.ProductVersion)"
           UpgradeCode="B975F792-6F80-4D56-8A64-D274A044DCF1"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Versi yang lebih baru dari Seruni 22 Bakery sudah terpasang." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <!-- Pagar kanal: MSI (per-mesin) dan installer EXE (per-pengguna) memakai folder data
         dan port yang sama. Installer EXE menulis Channel=exe di HKCU pengguna; selama
         penanda itu ada, MSI berhenti dengan pesan jelas alih-alih menumpuk salinan kedua.
         EXE 1.2.7 dan lebih lama belum menulis penanda itu, jadi entri Program dan Fitur
         milik Inno (AppId tetap {5D9D507C-...}_is1) ikut dicari.
         Batasan yang disadari: penanda HKCU hanya terbaca untuk pengguna yang menjalankan
         MSI. Bila EXE dipasang oleh pengguna Windows lain, MSI tidak bisa membaca hive-nya. -->
    <Property Id="EXECHANNEL" Secure="yes">
      <RegistrySearch Id="ExeChannelMarker" Root="HKCU" Key="Software\Seruni22Bakery"
                      Name="Channel" Type="raw" />
    </Property>
    <Property Id="EXEINSTALLED" Secure="yes">
      <RegistrySearch Id="ExeUninstallEntry" Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{5D9D507C-B7C6-4C4B-A6EE-6786A01F909A}_is1"
                      Name="DisplayName" Type="raw" />
    </Property>
    <Launch Condition="NOT (EXECHANNEL = &quot;exe&quot;) AND NOT EXEINSTALLED"
            Message="Instalasi Seruni 22 Bakery versi EXE masih terpasang untuk pengguna ini. Copot dulu lewat &quot;Uninstall Seruni 22 Bakery&quot; sebelum memasang MSI; dua kanal instalasi tidak boleh terpasang bersamaan karena memakai basis data dan port yang sama." />
    <!-- Tanpa gerbang "pasang .NET 8 dulu": publish dilakukan self-contained (hostfxr.dll dan
         coreclr.dll ikut di paket), jadi runtime bersama tidak dibutuhkan. Gerbang lama
         memeriksa folder Microsoft.AspNetCore.App 8.x dan menolak pemasangan di mesin bersih
         yang sebenarnya tidak membutuhkannya. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Seruni 22 Bakery" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppMenuShortcut" Guid="7C88062F-06E5-4713-B4C2-9E114D3C5233">
        <Shortcut Id="AppStartMenuLink"
                  Name="Seruni 22 Bakery"
                  Description="Sistem Toko Seruni 22 Bakery"
                  Target="[INSTALLFOLDER]Seruni22Bakery.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Seruni22Bakery" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="AppDesktopShortcut" Guid="8E77610A-3C99-4A73-A331-597A8BD59EE6">
        <Shortcut Id="AppDesktopLink"
                  Name="Seruni 22 Bakery"
                  Description="Sistem Toko Seruni 22 Bakery"
                  Target="[INSTALLFOLDER]Seruni22Bakery.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Seruni22Bakery" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <!-- Seluruh isi folder publish ikut dipaketkan. Daftar berkas manual sebelumnya hanya memuat
         exe dan wwwroot, sehingga DLL pendukung tidak terpasang dan aplikasi hasil MSI tidak bisa
         dijalankan. Harvester ini mengikuti hasil publish apa pun yang sedang ada. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>
    <!-- Penanda kanal di HKLM (terbaca semua pengguna) dan versi terpasang. Installer EXE
         membaca keduanya sebelum memasang, sehingga dua kanal tidak bisa diam-diam
         hidup berdampingan. -->
    <Component Id="ChannelMarker" Guid="3A0F4B1C-6E29-4C47-9D2B-7B5E1C8F2A64" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\Seruni22Bakery" Name="Channel" Type="string" Value="msi" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Seruni22Bakery" Name="Version" Type="string" Value="$(var.ProductVersion)" />
      <RegistryValue Root="HKLM" Key="Software\Seruni22Bakery" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
    </Component>
    <Feature Id="MainFeature" Title="Seruni 22 Bakery" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppMenuShortcut" />
      <ComponentRef Id="AppDesktopShortcut" />
      <ComponentRef Id="ChannelMarker" />
    </Feature>
  </Package>
</Wix>
