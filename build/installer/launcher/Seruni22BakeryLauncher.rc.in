// Sumber daya versi peluncur Seruni22Bakery.exe.
// Nilai @VERSI_QUAD@, @VERSI@, dan @IKON@ diganti oleh scripts/build-installer.ps1
// sebelum dikompilasi rc.exe; tanpa ini exe peluncur tampil sebagai 0.0.0.0 di
// properti berkas dan di panel Program & Fitur.
1 ICON "@IKON@"

1 VERSIONINFO
 FILEVERSION @VERSI_QUAD@
 PRODUCTVERSION @VERSI_QUAD@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Seruni 22\0"
            VALUE "FileDescription", "Peluncur Seruni 22 Bakery\0"
            VALUE "FileVersion", "@VERSI@\0"
            VALUE "InternalName", "Seruni22Bakery\0"
            VALUE "OriginalFilename", "Seruni22Bakery.exe\0"
            VALUE "ProductName", "Seruni 22 Bakery\0"
            VALUE "ProductVersion", "@VERSI@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Seruni 22\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
